{
    "name": "sympress/starter",
    "type": "project",
    "description": "SymPress Starter for WordPress projects",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.5",
        "sympress/kernel": "^1.1.5",
        "sympress/starter-site-policy": "^1.0",
        "sympress/monolog-bundle": "^1.1.4",
        "sympress/wp-cli-console": "^1.0.4",
        "roots/wordpress": "^7.1.1",
        "sympress/runtime": "^1.2.4",
        "wpackagist-theme/twentytwentyfive": "^1.5.0"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4.3",
        "phpstan/phpstan": "^2.2.2",
        "phpunit/phpunit": "^13.2",
        "sympress/coding-standards": "^1.1.1",
        "sympress/profiler": "^1.0.4",
        "symfony/var-dumper": "^8.1.0",
        "szepeviktor/phpstan-wordpress": "^2.0.3"
    },
    "extra": {
        "wordpress-install-dir": "public/wp",
        "wordpress-content-dir": "public/wp-content",
        "sympress-runtime": "dev-ops/runtime.json",
        "installer-paths": {
            "public/wp-content/mu-plugins/{$name}": [
                "type:wordpress-muplugin"
            ],
            "public/wp-content/plugins/{$name}": [
                "type:wordpress-plugin"
            ],
            "public/wp-content/themes/{$name}": [
                "type:wordpress-theme"
            ]
        },
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "scripts": {
        "setup": "bin/console setup",
        "qa:audit": "composer audit --locked --no-interaction",
        "cs": "vendor/bin/phpcs --standard=phpcs.xml.dist",
        "cs:fix": "vendor/bin/phpcbf --standard=phpcs.xml.dist",
        "static-analysis": "vendor/bin/phpstan analyse -c phpstan.neon.dist --no-progress",
        "test": "vendor/bin/phpunit --configuration phpunit.xml.dist",
        "qa": [
            "@qa:audit",
            "@cs",
            "@static-analysis",
            "@test"
        ],
        "cleanup": "rm -rf ./public/wp/wp-content",
        "post-install-cmd": [
            "@cleanup"
        ],
        "post-update-cmd": [
            "@cleanup"
        ],
        "runtime:setup": "@php vendor/bin/runtime",
        "qa:production": "@php vendor/bin/runtime doctor --production --database-health",
        "qa:operations": "python3 -m unittest discover -s dev-ops/tests -v"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "roots/wordpress-core-installer": true,
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "sympress/runtime": true,
            "phpstan/extension-installer": true
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail",
                "ignore-id": {
                    "CVE-2022-3590": "Wordfence marks every WordPress version affected and no patched release exists; keep outbound HTTP restricted and review this waiver regularly.",
                    "CVE-2017-14990": "Wordfence marks every WordPress version affected and no patched release exists; production multisite signup is disabled."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "./packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "sympress/starter-site-policy": "1.0.0"
                }
            }
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        {
            "name": "wpsecadv",
            "type": "composer",
            "url": "https://repo-wpsecadv.typist.tech",
            "only": [
                "roots/wordpress-no-content",
                "wpackagist-plugin/*",
                "wpackagist-theme/*"
            ]
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "SymPress\\Starter\\Tests\\": "tests/"
        }
    }
}
