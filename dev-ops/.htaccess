# SymPress deny rules: keep in sync with dev-ops/nginx/security.conf.
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteRule ^(?:[_0-9a-z-]+/)?wp-content/(?:uploads|cache|upgrade)/.*\.(?:php[0-9s]*|pht(?:ml)?|phar|inc)(?:/|$) - [NC,R=404,L]
	RewriteRule ^(?:wp/)?xmlrpc\.php(?:/|$) - [NC,F,L]
	RewriteRule (?:^|/)\.(?!well-known/) - [NC,F,L]
	RewriteRule \.(?:sql|bak|ini|log|conf|sh|env)(?:$|/) - [NC,F,L]
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteRule ^index\.php$ - [L]

	#RewriteCond %{HTTPS} off
    #RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

	# uploaded files
	#RewriteRule ^([_0-9a-zA-Z-]+/)?files/(.+) wp/wp-includes/ms-files.php?file=$2 [L]

	# add a trailing slash to /wp-admin
	RewriteRule ^(?:([_0-9a-zA-Z-]+)/)?wp-admin$ $1/wp-admin/ [R=301,L]

	#Options -Indexes +SymLinksIfOwnerMatch

	RewriteCond %{ENV:REDIRECT_STATUS} 200 [OR]
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]
	RewriteRule ^(?:(?:[_0-9a-zA-Z-]+)/)?(wp-(admin|includes).*) wp/$1 [L]
	RewriteRule ^(?:(?:[_0-9a-zA-Z-]+)/)?(.*\.php)$ wp/$1 [L]
	RewriteRule ^[_0-9a-zA-Z-]+/wp-content/(.*) wp-content/$1 [L]
	RewriteRule . index.php [L]
</IfModule>

# END WordPress