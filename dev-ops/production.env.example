WORDPRESS_ENV=production
SYMPRESS_ENABLE_WORDPRESS_HARDENING=true
SYMPRESS_ENABLE_WORDPRESS_LEGACY_CLEANUP=false
DISALLOW_UNFILTERED_HTML=true
ALLOW_UNFILTERED_UPLOADS=false
WP_HTTP_BLOCK_EXTERNAL=true
WP_ACCESSIBLE_HOSTS=api.wordpress.org,downloads.wordpress.org
SYMPRESS_KERNEL_IMMUTABLE_CACHE=true
# Replace for every release; deployment recipes set this from release_name.
SYMPRESS_KERNEL_BUILD_ID=replace-with-unique-release-id
