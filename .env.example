# Runtime
WORDPRESS_ENV=development

# Database
DB_HOST=db
DB_NAME=db
DB_USER=db
DB_PASSWORD=db

# Local URL
WP_HOME=https://sympress-starter.ddev.site
WP_SITEURL=${WP_HOME}

# Local WordPress installer
WP_ADMIN_USERNAME=admin
WP_ADMIN_PASSWORD=

# SymPress starter features
# Runtime enables hardening in production; explicit overrides are optional.
# SYMPRESS_ENABLE_WORDPRESS_HARDENING=false
SYMPRESS_ENABLE_WORDPRESS_LEGACY_CLEANUP=false
SYMPRESS_ENABLE_VARDUMPER=false

# Multisite defaults
WP_ALLOW_MULTISITE=false
MULTISITE=false
SUBDOMAIN_INSTALL=false

# Common production toggles
# DISALLOW_FILE_EDIT=true
# DISALLOW_FILE_MODS=true
# DISALLOW_UNFILTERED_HTML=true
# ALLOW_UNFILTERED_UPLOADS=false
# DISABLE_WP_CRON=true
# FORCE_SSL_ADMIN=true
# WP_DEBUG=false
# WP_DEBUG_DISPLAY=false
# WP_DEBUG_LOG=true
# WP_HTTP_BLOCK_EXTERNAL=true

WP_ADMIN_EMAIL=admin@example.invalid
# Reverse proxies must match the immediate REMOTE_ADDR IP or CIDR.
# WP_FORCE_SSL_FORWARDED_PROTO=true
# SYMPRESS_RUNTIME_TRUSTED_PROXIES=10.10.0.0/24,2001:db8::/64
